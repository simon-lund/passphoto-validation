   "metadata": {},
   "cell_type": "raw",
   "source": [
    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"# Passport Photo Validation - Check Visualizer\\n\",\n",
    "    \"\\n\",\n",
    "    \"This notebook is for running individual validation checks and visualizing their internal results for debugging and development.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"import sys\\n\",\n",
    "    \"import os\\n\",\n",
    "    \"import cv2\\n\",\n",
    "    \"import numpy as np\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Add the src directory to the Python path\\n\",\n",
    "    \"sys.path.insert(0, str(Path.cwd().parent / 'src'))\\n\",\n",
    "    \"\\n\",\n",
    "    \"from edutap.image_api.core.validator import PassportPhotoValidator\\n\",\n",
    "    \"from edutap.image_api.core.models import ValidationContext\\n\",\n",
    "    \"from edutap.image_api.core.checks import background, lighting, geometry, features, quality\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Setup and Image Loading\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Initialize the validator (we need it for its helper methods)\\n\",\n",
    "    \"validator = PassportPhotoValidator()\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Select an image to analyze\\n\",\n",
    "    \"image_path = Path.cwd().parent / 'tests' / 'test-images' / '1.jpg'\\n\",\n",
    "    \"image_np = cv2.imread(str(image_path))\\n\",\n",
    "    \"\\n\",\n",
    "    \"if image_np is None:\\n\",\n",
    "    \"    print(f\\\"Error: Could not load image from {image_path}\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(f\\\"Image loaded: {image_np.shape[1]}x{image_np.shape[0]} pixels\\\")\\n\",\n",
    "    \"    plt.figure(figsize=(6, 8))\\n\",\n",
    "    \"    plt.imshow(cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB))\\n\",\n",
    "    \"    plt.title('Original Image')\\n\",\n",
    "    \"    plt.axis('off')\\n\",\n",
    "    \"    plt.show()\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Create a Validation Context\\n\",\n",
    "    \"\\n\",\n",
    "    \"To test a check function, we first need to create a `ValidationContext` and populate it with the necessary data (like face detection results) that the check function expects.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"context = ValidationContext(image_np=image_np)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Run face detection and populate the context\\n\",\n",
    "    \"detection_results = validator._detect_faces(context)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if not detection_results or not detection_results.detections:\\n\",\n",
    "    \"    print(\\\"Could not detect a face in the image.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    # Use the first detected face\\n\",\n",
    "    \"    validator._populate_face_data(context, detection_results.detections[0])\\n\",\n",
    "    \"    print(\\\"ValidationContext created and populated with face data.\\\")\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## Visualize `check_background`\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Run the background check with debug=True to get visualization data\\n\",\n",
    "    \"background_viz_data = background.check_background(context, debug=True)\\n\",\n",
    "    \"\\n\",\n",
    "    \"if background_viz_data and 'background_mask' in background_viz_data:\\n\",\n",
    "    \"    print(\\\"Successfully received visualization data from check_background.\\\")\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    mask = background_viz_data['background_mask']\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Create an overlay image\\n\",\n",
    "    \"    overlay = cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB)\\n\",\n",
    "    \"    overlay[mask == 0] = [255, 0, 255] # Highlight non-background areas in magenta\\n\",\n",
    "    \"\\n\",\n",
    "    \"    fig, (ax1, ax2, ax3) = plt.subplots(1, 3, figsize=(20, 6))\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax1.imshow(cv2.cvtColor(image_np, cv2.COLOR_BGR2RGB))\\n\",\n",
    "    \"    ax1.set_title('Original Image')\\n\",\n",
    "    \"    ax1.axis('off')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    ax2.imshow(mask, cmap='gray')\\n\",\n",
    "    \"    ax2.set_title('Background Mask')\\n\",\n",
    "    \"    ax2.axis('off')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    ax3.imshow(overlay)\\n\",\n",
    "    \"    ax3.set_title('Analyzed Background Area')\\n\",\n",
    "    \"    ax3.axis('off')\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    plt.suptitle('`check_background` Visualization', fontsize=16, weight='bold')\\n\",\n",
    "    \"    plt.show()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # Print the issues that were added to the context\\n\",\n",
    "    \"    print(\\\"\\\\nIssues found by this check:\\\")\\n\",\n",
    "    \"    if context.issues:\\n\",\n",
    "    \"        for issue in context.issues:\\n\",\n",
    "    \"            print(f\\\"- {issue.message}\\\")\\n\",\n",
    "    \"    else:\\n\",\n",
    "    \"        print(\\\"No issues found.\\\")\\n\",\n",
    "    \"else:\\n\",\n",
    "    \"    print(\\\"Did not receive visualization data.\\\")\"\n",
    "   ]\n",
    "  }\n",
    " ],\n",
